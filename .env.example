# Granola personal API key. Create one in the Granola desktop app:
#   Settings -> Connectors -> API keys -> Create new key (choose Personal notes + Public notes)
GRANOLA_API_KEY=grn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key (needed for the Claude models).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key (needed only when a gpt-* model is selected). From platform.openai.com.
# OPENAI_API_KEY=sk-...

# Google Gemini API key (needed only when a gemini-* model is selected). From aistudio.google.com.
# GEMINI_API_KEY=AIza...

# Model defaults. The GUI offers seven, with the effort each runs at:
#   strongest: claude-fable-5-2 (max), gpt-6-astra (max), claude-opus-5-5 (max), gemini-4-carbon (high)
#   faster and cheaper: claude-sonnet-5-5 (max), gemini-4-hydrogen (xhigh), gpt-6.1-terra (max)
# Any other id also works when typed on the CLI; gemini-* ids route to Google, gpt-* to OpenAI, everything else to Anthropic.
# LLM_MODEL=claude-opus-5-5          # answers and profile synthesis
# LLM_EFFORT=high                    # low | medium | high | xhigh | max (Gemini tops out at xhigh on Hydrogen, high elsewhere)
# LLM_EXTRACT_MODEL=claude-opus-5-5  # per-meeting evidence extraction during profile builds
# LLM_EXTRACT_EFFORT=medium

# DATA_DIR=./data                    # where the local archive lives
# ME_EMAIL=you@example.com           # override the "me" identity (defaults to the note owner email)
# ME_NAME=Your Name
