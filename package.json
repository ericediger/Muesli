{
  "name": "muesli",
  "version": "0.1.0",
  "private": true,
  "description": "API-level assistant for Granola meeting notes: selective transcript export, scoped LLM queries, and per-person profiles.",
  "type": "module",
  "bin": {
    "granola": "./bin/granola.js"
  },
  "scripts": {
    "granola": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "gui": "tsx src/server.ts",
    "gui:build": "tsc && node dist/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@google/genai": "^2.24.0",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "openai": "7.57.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
